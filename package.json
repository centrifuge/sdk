{
  "name": "centrifuge-sdk-workspace",
  "private": true,
  "packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee",
  "scripts": {
    "build:packages": "pnpm --filter @centrifuge/protocol run build && pnpm --filter @centrifuge/queries run build",
    "test:packages": "pnpm --filter @centrifuge/protocol test && pnpm --filter @centrifuge/queries test",
    "api-report:check": "pnpm --filter @centrifuge/sdk run api-report:check",
    "typecheck": "pnpm -r --workspace-concurrency=1 --if-present typecheck",
    "build:publish": "pnpm --filter @centrifuge/sdk run build:publish",
    "verify:publish": "pnpm --filter @centrifuge/sdk run verify:publish",
    "test:unit": "pnpm --filter @centrifuge/sdk run test:unit"
  }
}
