{
  "name": "@centrifuge/queries",
  "version": "0.1.0",
  "private": true,
  "license": "LGPL-3.0-only",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "description": "Named query catalogue for the Centrifuge SDK: entry names with typed variables and results (core), plus adapters over the public GraphQL API (graphql) and the backend REST endpoints (rest).",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./graphql": {
      "types": "./dist/graphql/index.d.ts",
      "default": "./dist/graphql/index.js"
    },
    "./rest": {
      "types": "./dist/rest/index.d.ts",
      "default": "./dist/rest/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --config vitest.config.mts --project unit"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "25.9.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
