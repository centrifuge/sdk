{
  "name": "@centrifuge/sdk",
  "version": "3.0.0",
  "description": "",
  "homepage": "https://github.com/centrifuge/sdk/tree/main#readme",
  "author": "",
  "repository": {
    "type": "git",
    "url": "https://github.com/centrifuge/sdk.git"
  },
  "license": "LGPL-3.0-only",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./backend": {
      "types": "./dist/backend/index.d.ts",
      "default": "./dist/backend/index.js"
    }
  },
  "typings": "./dist/index.d.ts",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "backend": [
        "./dist/backend/index.d.ts"
      ]
    }
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "dev": "tsc -w --importHelpers",
    "build": "pnpm --filter @centrifuge/protocol run build && pnpm --filter @centrifuge/queries run build && tsup && tsc -p tsconfig.build.json",
    "build:tsc": "tsc --importHelpers",
    "typecheck": "pnpm --filter @centrifuge/protocol run build && pnpm --filter @centrifuge/queries run build && tsc --noEmit -p tsconfig.json",
    "api-report": "api-extractor run --local",
    "api-report:check": "api-extractor run",
    "check:transport-purity": "node scripts/assert-transport-purity.mjs",
    "test": "mocha --loader=ts-node/esm --require $(pwd)/src/tests/setup.ts --exit --timeout 30000 'src/**/*.test.ts' --recursive",
    "test:unit": "mocha --loader=ts-node/esm --config .mocharc.unit.cjs",
    "test:fork": "mocha --loader=ts-node/esm --config .mocharc.fork.cjs",
    "test:simple": "mocha --loader=ts-node/esm --exit --timeout 30000 'src/**/*.test.ts'",
    "test:simple:single": "mocha --loader=ts-node/esm --exit --timeout 30000",
    "test:single": "mocha --loader=ts-node/esm --require $(pwd)/src/tests/setup.ts --exit --timeout 30000",
    "test:ci": "pnpm test --reporter mocha-multi-reporters --reporter-options configFile=mocha-reporter-config.json",
    "test:coverage": "c8 pnpm test:ci",
    "fork:server": "node ./src/tests/forkServer.mjs",
    "gen:docs": "typedoc",
    "format": "prettier --write '**/*.{ts,js,mjs,json,md,yml}'",
    "build:publish": "node scripts/build-publish.mjs",
    "check:publish-safety": "node scripts/assert-publish-safety.mjs",
    "verify:publish": "node scripts/verify-publish-artifact.mjs"
  },
  "dependencies": {
    "@centrifuge/protocol": "workspace:*",
    "@centrifuge/queries": "workspace:*",
    "@openzeppelin/merkle-tree": "1.0.8",
    "decimal.js-light": "2.5.1",
    "isomorphic-ws": "5.0.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "viem": "2.57.13"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "7.60.0",
    "@types/chai": "5.0.0",
    "@types/mocha": "10.0.9",
    "@types/node": "22.7.8",
    "@types/sinon": "17.0.3",
    "@types/sinon-chai": "4.0.1",
    "c8": "10.1.2",
    "chai": "5.1.2",
    "dotenv": "16.4.5",
    "esbuild": "0.28.2",
    "eslint": "9.12.0",
    "globals": "15.11.0",
    "mocha": "10.7.3",
    "mocha-multi-reporters": "1.5.2",
    "mochawesome": "7.1.4",
    "npm-run-all": "4.1.5",
    "prettier": "3.9.10",
    "sinon": "19.0.2",
    "sinon-chai": "4.0.1",
    "source-map-support": "0.5.21",
    "ts-node": "10.9.2",
    "tsup": "8.5.1",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.14.1",
    "typescript": "5.6.3",
    "typescript-eslint": "8.72.1"
  }
}
